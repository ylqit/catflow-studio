# Reuse an existing PostgreSQL instance. The API remains loopback-only even when the
# database server is remote. Keep the real credentials in the ignored .env file.
CATFLOW_DB_HOST=127.0.0.1
CATFLOW_DB_PORT=5432
CATFLOW_DB_NAME=catflow_studio
CATFLOW_DB_USER=postgres
CATFLOW_DB_PASSWORD=
CATFLOW_DB_SSLMODE=prefer
CATFLOW_MEDIA_ROOT=var/media
CATFLOW_WORK_ROOT=var/work
CATFLOW_CANON_ROOT=assets/canon/v4
CATFLOW_LOG_ROOT=var/logs
CATFLOW_BACKUP_ROOT=var/backups
CATFLOW_PORT=8877
CATFLOW_PROVIDER=fake
CATFLOW_PAID_CALLS_ENABLED=false

# Optional Ark adapter. Real paid calls remain disabled until explicitly enabled.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_PLANNING_MODEL=doubao-seed-2-1-pro-260628
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_VIDEO_MODEL=doubao-seedance-2-0-260128
ARK_DIAGNOSTIC_MODEL=doubao-seed-2-1-pro-260628

# Leave empty to discover from PATH.
FFMPEG_PATH=
FFPROBE_PATH=
