# Reuse an existing PostgreSQL instance. The API remains loopback-only even when the
# database server is remote. Keep the real credentials in the ignored .env file.
CATFLOW_DB_HOST=127.0.0.1
CATFLOW_DB_PORT=5432
CATFLOW_DB_NAME=catflow_studio
CATFLOW_DB_USER=postgres
CATFLOW_DB_PASSWORD=
CATFLOW_DB_SSLMODE=prefer
CATFLOW_MEDIA_ROOT=var/media
CATFLOW_WORK_ROOT=var/work
CATFLOW_CANON_ROOT=assets/canon/v4
CATFLOW_LOG_ROOT=var/logs
CATFLOW_BACKUP_ROOT=var/backups
CATFLOW_PORT=8877
CATFLOW_PAID_CALLS_ENABLED=false

# Optional Ark adapter. Real paid calls remain disabled until explicitly enabled.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_PLANNING_MODEL=doubao-seed-2-1-pro-260628
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_VIDEO_MODEL=doubao-seedance-2-0-260128
ARK_DIAGNOSTIC_MODEL=doubao-seed-2-1-pro-260628

# Private S3-compatible publication boundary for Ark segment-repair inputs. The TOS
# defaults below use its public S3-compatible endpoint and VirtualHostStyle. Keep the
# credentials blank here and put their real values only in the ignored .env file.
CATFLOW_OBJECT_STORAGE_BACKEND=s3
CATFLOW_OBJECT_STORAGE_ENDPOINT=https://tos-s3-cn-beijing.volces.com
CATFLOW_OBJECT_STORAGE_PUBLIC_ENDPOINT=https://tos-s3-cn-beijing.volces.com
CATFLOW_OBJECT_STORAGE_REGION=cn-beijing
CATFLOW_OBJECT_STORAGE_BUCKET=test-vedio-ylq
CATFLOW_OBJECT_STORAGE_ACCESS_KEY_ID=
CATFLOW_OBJECT_STORAGE_SECRET_ACCESS_KEY=
CATFLOW_OBJECT_STORAGE_ADDRESSING_STYLE=virtual
CATFLOW_OBJECT_STORAGE_PREFIX=catflow/segment-references
CATFLOW_OBJECT_STORAGE_PRESIGN_TTL_SECONDS=7200
CATFLOW_OBJECT_STORAGE_RETENTION_DAYS=7

# MinIO switch example (the public endpoint must remain reachable by Ark over HTTPS):
# CATFLOW_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
# CATFLOW_OBJECT_STORAGE_PUBLIC_ENDPOINT=https://media.example.com
# CATFLOW_OBJECT_STORAGE_REGION=us-east-1
# CATFLOW_OBJECT_STORAGE_BUCKET=catflow-temp
# CATFLOW_OBJECT_STORAGE_ADDRESSING_STYLE=path

# Leave empty to discover from PATH.
FFMPEG_PATH=
FFPROBE_PATH=
