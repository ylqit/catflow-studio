# Ark标准API。密钥只写入被Git忽略的.env或当前PowerShell会话。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
# 每张镜头卡独立生成8～15秒视频片段。
ARK_VIDEO_MODEL=doubao-seedance-2-0-260128
# 用于按场景给出镜头卡建议。
ARK_PLANNING_MODEL=doubao-seed-2-1-pro-260628
ARK_REVIEW_MODEL=doubao-seed-2-1-pro-260628
ARK_RESPONSES_STRUCTURED_OUTPUT_MODE=json_object_schema_prompt
ARK_VIDEO_RESOLUTION=720p
ARK_DIRECTOR_REQUEST_TIMEOUT_SECONDS=240
ARK_REVIEW_REQUEST_TIMEOUT_SECONDS=240
ARK_VIDEO_API_TIMEOUT_SECONDS=120
ARK_POLL_INTERVAL_SECONDS=10
ARK_TASK_TIMEOUT_SECONDS=1800
# Seedream镜头锚点是同步长请求，单独保留较长等待窗口。
ARK_IMAGE_REQUEST_TIMEOUT_SECONDS=600
# 视频语义分析只给出建议，批准与拒绝始终由人工决定。
VIDEO_SEMANTIC_REVIEW_MODE=diagnostic

# 媒体工具：留空时从PATH发现。
FFMPEG_PATH=
FFPROBE_PATH=
MEDIA_WORK_ROOT=var/work
MEDIA_ASSET_ROOT=var/assets

# PostgreSQL：正式环境优先使用require或安全隧道。
CAT_VIDEO_DB_HOST=
CAT_VIDEO_DB_PORT=5432
CAT_VIDEO_DB_NAME=vedio-appdb
CAT_VIDEO_DB_USER=postgres
CAT_VIDEO_DB_PASSWORD=
CAT_VIDEO_DB_SSLMODE=require
CAT_VIDEO_DB_SCHEMA=cat_video
CAT_VIDEO_ALLOW_INSECURE_RUNTIME=false
CAT_VIDEO_ALLOW_INSECURE_READONLY_SMOKE=false
